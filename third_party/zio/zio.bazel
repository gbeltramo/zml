load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_zig//zig:defs.bzl", "zig_binary", "zig_library")
load("@zml//bazel:zig_options.bzl", "zig_option", "zig_options")

zig_option(
    name = "backend",
    string = "",
    nullable = True,
)

string_flag(
    name = "resolve_beneath_mode_flag",
    build_setting_default = "strict",
    values = ["strict", "best_effort"],
)

config_setting(
    name = "resolve_beneath_mode_strict",
    flag_values = {":resolve_beneath_mode_flag": "strict"},
)

config_setting(
    name = "resolve_beneath_mode_best_effort",
    flag_values = {":resolve_beneath_mode_flag": "best_effort"},
)

zig_option(
    name = "resolve_beneath_mode",
    string = select({
        ":resolve_beneath_mode_best_effort": "best_effort",
        ":resolve_beneath_mode_strict": "strict",
    }),
)

zig_option(name = "no_hacks", bool = False)
zig_option(name = "scheduling", string = "work_stealing")
zig_option(name = "scheduler_metrics", bool = False)

zig_options(
    name = "zio_build_options",
    settings = [
        ":backend",
        ":resolve_beneath_mode",
        ":no_hacks",
        ":scheduling",
        ":scheduler_metrics",
    ],
)

zig_library(
    name = "zio",
    main = "src/zio.zig",
    srcs = glob(["src/**/*.zig"]),
    deps = [":zio_build_options"],
    visibility = ["//visibility:public"],
)
